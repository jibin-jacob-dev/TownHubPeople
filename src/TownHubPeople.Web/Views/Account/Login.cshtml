@model TownHubPeople.Web.ViewModels.Account.LoginViewModel
@using TownHubPeople.Domain.Entities.Admin
@{
    ViewData["Title"] = "Login";
    Layout = null;
    var slides = ViewBag.Slides as List<LoginPageSlide> ?? [];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In - TownHub People</title>
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- Left: Showcase Panel -->
        <div class="login-showcase">
            <div class="showcase-pattern"></div>

            @if (slides.Count > 0)
            {
                <div class="showcase-slides">
                    @foreach (var (slide, idx) in slides.Select((s, i) => (s, i)))
                    {
                        var hasImage = !string.IsNullOrEmpty(slide.ImageFileName);
                        <div class="showcase-slide @(idx == 0 ? "active" : "")" data-index="@idx">
                            @if (hasImage)
                            {
                                <div class="slide-bg-image" style="background-image: url('/uploads/slides/@slide.ImageFileName');"></div>
                            }
                            <div class="slide-overlay @(hasImage ? "has-image" : "")"></div>
                            <div class="slide-content">
                                @if (!hasImage)
                                {
                                    <div class="slide-icon" style="background: @(slide.IconColor)20; color: @slide.IconColor;">
                                        <i class="fas @slide.IconClass"></i>
                                    </div>
                                }
                                <div class="slide-title">@slide.Title</div>
                                <div class="slide-description">@slide.Description</div>
                            </div>
                        </div>
                    }
                </div>

                @if (slides.Count > 1)
                {
                    <div class="showcase-dots">
                        @foreach (var (slide, idx) in slides.Select((s, i) => (s, i)))
                        {
                            <div class="showcase-dot @(idx == 0 ? "active" : "")" data-index="@idx"></div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="showcase-slides">
                    <div class="showcase-slide active">
                        <div class="slide-overlay"></div>
                        <div class="slide-content">
                            <div class="slide-icon" style="background: rgba(59,130,246,0.15);">
                                <img src="~/icons/logo-townhub-nexus.png" alt="TownHub People" style="width:48px;height:48px;" />
                            </div>
                            <div class="slide-title">TownHub People</div>
                            <div class="slide-description">Enterprise resource planning, simplified.</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Login Form -->
        <div class="login-form-panel">
            <button type="button" class="login-theme-toggle" id="loginThemeToggle" title="Toggle theme">
                <i class="fas fa-moon theme-icon-dark"></i>
                <i class="fas fa-sun theme-icon-light" style="display:none;"></i>
            </button>

            <div class="login-brand">
                <div class="login-brand-row">
                    <div class="login-brand-icon login-brand-icon--plain">
                        <img src="~/icons/logo-townhub-nexus.png" class="login-brand-img" alt="TownHub People" />
                    </div>
                    <span class="login-brand-name">TownHub <strong>People</strong></span>
                </div>
                <h1>Welcome back</h1>
                <p>Log in to TownHub People to continue</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="login-form" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="login-alert" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="login-input-wrap">
                        <input asp-for="Email" class="form-control" placeholder="you@@example.com" autocomplete="email" />
                        <i class="fas fa-envelope field-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="login-input-wrap">
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" id="passwordInput" />
                        <i class="fas fa-lock field-icon"></i>
                        <button type="button" class="password-toggle" id="passwordToggle" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="login-options">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                    </div>
                </div>

                <button type="submit" class="login-btn" id="loginBtn">
                    <span class="btn-text"><i class="fas fa-arrow-right me-2"></i>Log In</span>
                    <span class="btn-loader"><div class="spinner"></div><span>Logging in...</span></span>
                </button>
            </form>

            <div class="login-footer">
                <p>Don't have an account? <a asp-action="Register">Create one</a></p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
