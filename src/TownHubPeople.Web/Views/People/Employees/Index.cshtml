@{
    ViewData["Title"] = "Employees";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "People" })

<erp-page-header module="People" item="Employees">
    <button type="button" class="btn btn-primary btn-sm" data-form-url="@Url.Action("Create")" data-form-title="Add Employee">
        <i class="fas fa-plus me-1"></i>Add Employee
    </button>
</erp-page-header>

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <table id="dataTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Manager</th>
                    <th>Status</th>
                    <th width="130">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function employeeStatusBadge(s) {
        var map = { Active: 'bg-success', Probation: 'bg-info', OnLeave: 'bg-warning', Suspended: 'bg-secondary', Exited: 'bg-danger' };
        return '<span class="badge ' + (map[s] || 'bg-secondary') + '">' + s + '</span>';
    }

    var table = initDataTable('dataTable', '@Url.Action("GetData")', [
        { data: 'employeeCode' },
        { data: 'name', render: function (n, t, row) { return '<a href="/People/Employees/Details/' + row.id + '">' + n + '</a>'; } },
        { data: 'department', render: function (d) { return d || '<span class="text-muted">-</span>'; } },
        { data: 'designation', render: function (d) { return d || '<span class="text-muted">-</span>'; } },
        { data: 'manager', render: function (d) { return d || '<span class="text-muted">-</span>'; } },
        { data: 'status', render: employeeStatusBadge },
        { data: 'id', orderable: false, render: function (d) {
            return '<a href="/People/Employees/Details/' + d + '" class="btn btn-sm btn-outline-secondary me-1" title="View"><i class="fas fa-eye"></i></a>'
                 + '<button type="button" class="btn btn-sm btn-outline-primary me-1" data-form-url="/People/Employees/Edit/' + d + '" data-form-title="Edit Employee"><i class="fas fa-edit"></i></button>'
                 + '<button class="btn btn-sm btn-outline-danger" data-delete-url="/People/Employees/Delete/' + d + '"><i class="fas fa-trash"></i></button>';
        }}
    ]);
</script>
}
