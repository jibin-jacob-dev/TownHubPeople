@model TownHubPeople.Web.ViewModels.Setup.GradeViewModel
@{
    var isEdit = Model.Id != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Level" class="form-label"></label>
            <input asp-for="Level" type="number" class="form-control" />
            <span asp-validation-for="Level" class="text-danger small"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="MinSalary" class="form-label"></label>
            <input asp-for="MinSalary" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="MinSalary" class="text-danger small"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="MaxSalary" class="form-label"></label>
            <input asp-for="MaxSalary" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="MaxSalary" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-12 mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-actions mt-3">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>
