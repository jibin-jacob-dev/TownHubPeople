@{
    ViewData["Title"] = "Holiday Calendars";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Setup" })

<erp-page-header module="Workforce Setup" item="Holiday Calendars">
    <button type="button" class="btn btn-primary btn-sm" data-form-url="@Url.Action("Create")" data-form-title="Add Holiday Calendar">
        <i class="fas fa-plus me-1"></i>Add Calendar
    </button>
</erp-page-header>

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <table id="dataTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Location</th>
                    <th>Active</th>
                    <th width="130">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script>
    var table = initDataTable('dataTable', '@Url.Action("GetData")', [
        { data: 'name' },
        { data: 'year' },
        { data: 'location', render: function (d) { return d || '<span class="text-muted">-</span>'; } },
        { data: 'isActive', render: activeBadge },
        actionsColumn({
            edit: '/Setup/HolidayCalendars/Edit', editModal: true, editTitle: 'Edit Holiday Calendar',
            del: '/Setup/HolidayCalendars/Delete',
            extra: function (id) {
                return '<a href="/Setup/HolidayCalendars/Manage/' + id + '" class="btn btn-sm btn-outline-secondary ms-1" title="Manage holidays"><i class="fas fa-calendar-day"></i></a>';
            }
        })
    ]);
</script>
}
