@model TownHubPeople.Web.ViewModels.Admin.LoginSlideViewModel
@{
    ViewData["Title"] = "Create Login Slide";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Login Slides" action="Create" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Create Login Slide</h6></div>
            <div class="card-body">
                @await Html.PartialAsync("_CreateForm", Model)
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <erp-hints module="Admin" feature="LoginSlide" />
    </div>
</div>

@section Scripts {
    <script>
        initFormModalPlugins(document);
    </script>
}
