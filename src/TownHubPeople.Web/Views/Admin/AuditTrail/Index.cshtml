@{
    ViewData["Title"] = "Audit Trail";
    var entityNames = ViewBag.EntityNames as List<string> ?? [];
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Audit Trail" />

<div class="card mb-3">
    <div class="card-header"><h6 class="mb-0">Filters</h6></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-2">
                <label class="form-label">Entity</label>
                <select id="entityFilter" class="form-select form-select-sm">
                    <option value="">All Entities</option>
                    @foreach (var name in entityNames)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <label class="form-label">Action</label>
                <select id="actionFilter" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    <option value="Created">Created</option>
                    <option value="Modified">Modified</option>
                    <option value="Deleted">Deleted</option>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <label class="form-label">From Date</label>
                <input type="date" id="fromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 mb-2">
                <label class="form-label">To Date</label>
                <input type="date" id="toDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1 mb-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary btn-sm w-100" id="applyFilters">
                    <i class="fas fa-filter"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table id="auditTable" class="table table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        var table = $('#auditTable').DataTable({
            processing: true,
            serverSide: true,
            scrollY: 'calc(100vh - 420px)',
            scrollCollapse: true,
            order: [[0, 'desc']],
            ajax: {
                url: '/Admin/AuditTrail/GetData',
                type: 'POST',
                contentType: 'application/json',
                data: function (d) {
                    return JSON.stringify(d);
                },
                beforeSend: function (xhr, settings) {
                    var entity = $('#entityFilter').val();
                    var action = $('#actionFilter').val();
                    var fromDate = $('#fromDate').val();
                    var toDate = $('#toDate').val();
                    var params = [];
                    if (entity) params.push('entity=' + encodeURIComponent(entity));
                    if (action) params.push('action=' + encodeURIComponent(action));
                    if (fromDate) params.push('fromDate=' + encodeURIComponent(fromDate));
                    if (toDate) params.push('toDate=' + encodeURIComponent(toDate));
                    if (params.length > 0) {
                        settings.url += '?' + params.join('&');
                    }
                }
            },
            columns: [
                {
                    data: 'timestamp',
                    render: function (data) {
                        return new Date(data).toLocaleString();
                    }
                },
                { data: 'userName' },
                { data: 'entityName' },
                { data: 'entityId' },
                {
                    data: 'action',
                    render: function (data) {
                        var badge = data === 'Created' ? 'success' : data === 'Modified' ? 'primary' : 'danger';
                        return '<span class="badge bg-' + badge + '">' + data + '</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function (data) {
                        return '<a href="/Admin/AuditTrail/Details/' + data + '" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a>';
                    }
                }
            ]
        });

        $('#applyFilters').on('click', function () {
            table.ajax.reload();
        });
    });
</script>
}
