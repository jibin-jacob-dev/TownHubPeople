@model TownHubPeople.Web.ViewModels.Admin.CreateRoleViewModel
@{
    ViewData["Title"] = "Edit Role";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Roles" action="Edit" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                @await Html.PartialAsync("_EditForm", Model)
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <erp-hints module="Admin" feature="Role" />
    </div>
</div>

@await Html.PartialAsync("_HistoryPanel", (EntityName: "ApplicationRole", EntityId: ((int)ViewBag.Id).ToString()))

@section Scripts {
    <script>
        initFormModalPlugins(document);
    </script>
}
