@model TownHubPeople.Web.ViewModels.Admin.CreateRoleViewModel
@{
    ViewData["Title"] = "Create Role";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Roles" action="Create" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                @await Html.PartialAsync("_CreateForm", Model)
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <erp-hints module="Admin" feature="Role" />
    </div>
</div>

@section Scripts {
    <script>
        initFormModalPlugins(document);
    </script>
}
