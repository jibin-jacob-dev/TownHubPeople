@model TownHubPeople.Web.ViewModels.Admin.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Users" action="Edit" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                @await Html.PartialAsync("_EditForm", Model)
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <erp-hints module="Admin" feature="User" />
    </div>
</div>

@await Html.PartialAsync("_HistoryPanel", (EntityName: "ApplicationUser", EntityId: Model.Id))

@section Scripts {
    <script>
        initFormModalPlugins(document);
    </script>
}
