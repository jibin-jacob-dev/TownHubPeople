@model TownHubPeople.Web.ViewModels.Admin.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

@await Component.InvokeAsync("ModuleTabs", new { moduleKey = "Administration" })

<erp-page-header module="Administration" item="Users" action="Create" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                @await Html.PartialAsync("_CreateForm", Model)
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <erp-hints module="Admin" feature="User" />
    </div>
</div>

@section Scripts {
    <script>
        initFormModalPlugins(document);
    </script>
}
