@using TownHubPeople.Application.Admin.MenuConfiguration
@inject IMenuConfigurationService MenuConfigService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TownHub People</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon-180.png" />
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/rowgroup/1.5.0/css/rowGroup.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="d-flex" id="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div id="sidebar-overlay"></div>
            <aside id="sidebar-wrapper"><script>(function(){var s=document.getElementById('sidebar-wrapper');s.classList.add('sidebar-no-transition');if(localStorage.getItem('sidebarCollapsed')==='true'){s.classList.add('collapsed');}requestAnimationFrame(function(){requestAnimationFrame(function(){s.classList.remove('sidebar-no-transition');});});})();</script>
                <div class="sidebar-heading">
                    <img src="~/icons/logo-townhub-nexus.png" class="sidebar-logo" alt="TownHub People" />
                    <span class="nav-text">TownHub <strong>People</strong></span>
                </div>
                <nav class="sidebar-nav" aria-label="Main navigation">
                    @{
                        var userRoles = User.Claims
                            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                            .Select(c => c.Value)
                            .ToList();
                        var visibleMenuItems = await MenuConfigService.GetAccessibleMenuItemsAsync(userRoles);
                        var requestPathValue = Context.Request.Path.ToString();
                        var prevKey = "";
                    }
                    @foreach (var menu in visibleMenuItems)
                    {
                        if (menu.Key == "Dashboard")
                        {
                            <div class="sidebar-section-label nav-text">Overview</div>
                        }
                        if (prevKey == "Dashboard" && menu.Key != "Dashboard")
                        {
                            <div class="sidebar-divider"></div>
                            <div class="sidebar-section-label nav-text">Modules</div>
                        }
                        if (menu.Key == "Administration" && prevKey != "Administration")
                        {
                            <div class="sidebar-divider"></div>
                            <div class="sidebar-section-label nav-text">System</div>
                        }

                        var isActive = menu.Key == "Dashboard"
                            ? (requestPathValue.Equals("/", StringComparison.OrdinalIgnoreCase) || requestPathValue.StartsWith("/Home", StringComparison.OrdinalIgnoreCase))
                            : requestPathValue.StartsWith(menu.PathPrefix, StringComparison.OrdinalIgnoreCase);
                        var isDisabled = menu.Url == "#";

                        var menuUrl = menu.Url;
                        if (menu.Key != "Dashboard")
                        {
                            var firstTab = (await MenuConfigService.GetAccessibleTabsAsync(menu.Key, userRoles)).FirstOrDefault();
                            if (firstTab != null)
                            {
                                menuUrl = firstTab.Url;
                            }
                        }

                        <a href="@menuUrl" class="nav-link @(isActive ? "active" : "") @(isDisabled ? "disabled" : "")" aria-current="@(isActive ? "page" : null)">
                            <i class="fas @menu.Icon fa-fw" style="color:@menu.IconColor;" aria-hidden="true"></i><span class="nav-text">@menu.DisplayName</span>
                        </a>

                        prevKey = menu.Key;
                    }
                </nav>
                <div class="sidebar-footer">
                    <i class="fas fa-circle text-success me-1" style="font-size: 0.5rem;"></i><span class="nav-text"> v1.0.0</span>
                </div>
            </aside>
        }

        <div id="page-content-wrapper" class="flex-grow-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <header id="topbar">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                        <i class="fas fa-bars" aria-hidden="true"></i>
                    </button>
                    @{
                        var currentPath = Context.Request.Path.ToString();
                        var currentModule = SystemMenuItems.All.FirstOrDefault(m =>
                            m.Key == "Dashboard"
                                ? (currentPath.Equals("/", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Home", StringComparison.OrdinalIgnoreCase))
                                : currentPath.StartsWith(m.PathPrefix, StringComparison.OrdinalIgnoreCase));
                    }
                    @if (currentModule != null)
                    {
                        <span class="topbar-module @currentModule.CssModuleClass">
                            <i class="fas @currentModule.Icon"></i> @currentModule.DisplayName
                        </span>
                    }
                    <div class="topbar-right">
                        <button class="search-toggle-btn" id="searchToggle" type="button" title="Search (Ctrl+K)" aria-label="Search">
                            <i class="fas fa-search" aria-hidden="true"></i>
                        </button>
                        <div class="profile-dropdown">
                            <button class="profile-toggle" type="button" aria-label="User menu" aria-haspopup="true">
                                <div class="user-avatar" aria-hidden="true">@User.Identity?.Name?.Substring(0, 1).ToUpper()</div>
                                <span class="profile-name">@User.Identity?.Name</span>
                                <i class="fas fa-chevron-down profile-chevron" aria-hidden="true"></i>
                            </button>
                            <div class="profile-menu">
                                <div class="profile-menu-header">
                                    <div class="user-avatar user-avatar-lg">@User.Identity?.Name?.Substring(0, 1).ToUpper()</div>
                                    <div>
                                        <div class="fw-semibold">@User.Identity?.Name</div>
                                        <div class="text-muted small">Signed in</div>
                                    </div>
                                </div>
                                <div class="profile-menu-divider"></div>
                                <a href="/Account/Profile" class="profile-menu-item">
                                    <i class="fas fa-user fa-fw me-2"></i>My Profile
                                </a>
                                <div class="profile-menu-divider"></div>
                                <div class="profile-menu-item theme-toggle-row" id="themeToggleRow">
                                    <i class="fas fa-moon fa-fw me-2 theme-icon-dark"></i>
                                    <i class="fas fa-sun fa-fw me-2 theme-icon-light"></i>
                                    <span id="themeLabel">Dark Mode</span>
                                    <label class="theme-switch ms-auto">
                                        <input type="checkbox" id="themeToggle" aria-label="Toggle dark mode" />
                                        <span class="theme-slider"></span>
                                    </label>
                                </div>
                                <div class="profile-menu-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="profile-menu-item text-danger">
                                        <i class="fas fa-sign-out-alt fa-fw me-2"></i>Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </header>
            }

            <main id="main-content">
                @await RenderSectionAsync("Breadcrumb", required: false)

                @if (TempData["Notification"] != null)
                {
                    <div id="notification-data" data-notification="@TempData["Notification"]" style="display:none;"></div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
            <div class="search-modal">
                <div class="search-input-wrapper">
                    <i class="fas fa-search search-input-icon" aria-hidden="true"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Search modules, pages, actions..." autocomplete="off" aria-label="Search modules, pages, and actions" />
                    <kbd class="search-kbd">ESC</kbd>
                </div>
                <div id="searchResults" class="search-results"></div>
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.min.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.5.0/js/dataTables.rowGroup.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
