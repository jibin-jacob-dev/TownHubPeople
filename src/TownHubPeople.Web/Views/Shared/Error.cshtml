@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger"><i class="fas fa-exclamation-triangle"></i></h1>
    <h2>An error occurred</h2>
    <p class="text-muted">Something went wrong while processing your request.</p>
    @if (ViewBag.TraceId != null)
    {
        <p class="text-muted"><small>Trace ID: @ViewBag.TraceId</small></p>
    }
    <a href="/" class="btn btn-primary mt-3"><i class="fas fa-home me-1"></i>Back to Dashboard</a>
</div>
